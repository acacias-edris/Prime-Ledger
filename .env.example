# Copy to .env locally. NEVER commit .env or paste real keys into any cloud tool or free API.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database: SQLite for local 8GB RAM dev; swap to postgresql+asyncpg://... for Neon/Supabase cloud
DATABASE_URL=sqlite+aiosqlite:///./ledgerprime_dev.db

# Security (generate locally via: openssl rand -hex 32)
SECRET_KEY=replace_with_64_char_local_random_hex
BACKUP_ENCRYPTION_KEY=replace_with_fernet_key

# Phase 5 Optional Automation Adapters (Leave empty for 100% offline manual mode)
OCR_PROVIDER=mock
OCR_API_KEY=replace_with_ocr_key_if_enabled
BANK_FEED_PROVIDER=mock
BANK_FEED_CLIENT_ID=replace_with_sandbox_client_id
BANK_FEED_CLIENT_SECRET=replace_with_sandbox_secret
GSP_SANDBOX_BASE_URL=https://sandbox.example.gsp
GSP_CLIENT_ID=replace_with_gsp_sandbox_id
GSP_CLIENT_SECRET=replace_with_gsp_sandbox_secret
